# Supabase project settings (Project Settings > API / Database)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Server-only. Never prefix with NEXT_PUBLIC_. Grants full DB access, bypassing RLS.
SUPABASE_SERVICE_ROLE_KEY=your-secret-or-service-role-key

# Drizzle migrations (direct/pooled Postgres connection string)
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@your-pooler-host:6543/postgres

# Server-only, added in a later phase.
# ANTHROPIC_API_KEY=
# KIS_APP_KEY=
# KIS_APP_SECRET=
