# Supabase project settings (Project Settings > API / Database)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Base URL used to build the magic-link email's redirect (app/(auth)/login/actions.ts).
# Defaults to http://localhost:3000 when unset, which is correct for local dev but
# MUST be set to the real deployed URL in production (e.g. Vercel), or magic-link
# emails will redirect to localhost and fail to connect for anyone but the developer.
# NEXT_PUBLIC_SITE_URL=https://your-deployed-domain.vercel.app

# Server-only. Never prefix with NEXT_PUBLIC_. Grants full DB access, bypassing RLS.
SUPABASE_SERVICE_ROLE_KEY=your-secret-or-service-role-key

# Drizzle migrations (direct/pooled Postgres connection string)
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@your-pooler-host:6543/postgres

# Server-only, added in a later phase.
# ANTHROPIC_API_KEY=
# KIS_APP_KEY=
# KIS_APP_SECRET=

# Weekly digest email (app/api/cron/weekly-digest, .github/workflows/weekly-digest.yml).
# Server-only. Get an API key at resend.com (free tier: 3,000 emails/month).
# Without RESEND_KEY, the cron route no-ops (logs a warning) instead of failing.
# RESEND_KEY=re_your_api_key
# RESEND_FROM_EMAIL=TraderLab <onboarding@resend.dev>

# Server-only. A random string you generate yourself (e.g. `openssl rand -hex 32`) —
# shared between this app and the GitHub Actions secret of the same name, so the
# weekly-digest cron route can tell a real scheduled call apart from a random request.
# CRON_SECRET=
